# Wynncraft v3 API key (server-side only — never exposed to clients)
WYNN_API_KEY=

# Required for /api/cron/refresh authorization. Vercel Cron automatically sends
# `Authorization: Bearer ${CRON_SECRET}` when this env var is set on the project.
CRON_SECRET=

# Upstash Redis (Vercel Marketplace integration — connect a Redis store
# to the project and these are populated automatically). The legacy
# KV_REST_API_URL / KV_REST_API_TOKEN names are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
